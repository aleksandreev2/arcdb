# Local development configuration. scripts/dev_bootstrap.py copies this to .env.
ARCHIVEDB_LOCAL_DEV=1
ARCHIVEDB_NO_TELEGRAM=1
ARCHIVEDB_OPEN_BROWSER=1

# Generated automatically on first run. Do not reuse this value in production.
FLASK_SECRET_KEY=__AUTO_GENERATE__

# Local HTTP
HOST=127.0.0.1
PORT=5004
COOKIE_SECURE=0

# Local development account seeded automatically.
LOCAL_DEV_EMAIL=dev@arcdb.local
LOCAL_DEV_PASSWORD=arcdb-dev-123
ADMIN_EMAILS=dev@arcdb.local
DMCA_EMAIL=dmca@example.invalid

# Telegram is intentionally disabled locally by default.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
SESSION_PATH=./data/telegram/sigma_reverse_session

# SMTP is optional. Without it, verification codes are printed to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional MTProto proxy
USE_PROXY=0
MTPROXY_SERVER=
MTPROXY_PORT=443
MTPROXY_SECRET=

# Local data tree
TRANSLATED_CSV_PATH=./data/uploaded_novels_tracker.csv
RAW_MASTER_CSV_PATH=./data/master_library_index.csv
LOCAL_OUTPUT_DIR=./data/output
STRUCTURED_OUTPUT_DIR=./data/structured_output
BATCHED_EPUBS_DIR=./data/batched_epubs
META_DIR=./data/metadata
EPUB_PACKAGE_SESSIONS_DIR=./data/tmp/epub_package_sessions
SQLITE_DB_PATH=./data/arcdb.sqlite3

# SQLite shadow state migration. JSON is still the read source in this phase.
STATE_DUAL_WRITE=1
STATE_DUAL_WRITE_STRICT=1
STATE_DUAL_WRITE_VERIFY=1
STATE_DUAL_WRITE_LOG_SUCCESS=0
STATE_READ_BACKEND=legacy
STATE_READ_SHADOW_COMPARE=0
STATE_READ_SHADOW_STRICT=1
STATE_READ_SHADOW_REPORT_EVERY=1000

# Local limits / behavior
MAX_CONTENT_LENGTH=102760448
DAILY_DOWNLOAD_LIMIT=1000
MAX_EMAILS_PER_IP=0
MULTI_ACCOUNT_ENFORCE=log
