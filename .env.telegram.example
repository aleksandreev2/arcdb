# Private environment for arcdb-telegram only. Do not expose this file to arcdb-web.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
SESSION_PATH=/home/ubuntu/arcdb-data/telegram/sigma_reverse_session

# Must match TELEGRAM_SERVICE_TOKEN in the web environment (32+ random chars).
TELEGRAM_SERVICE_TOKEN=replace-with-a-separate-long-random-token
TELEGRAM_STARTUP_TIMEOUT_SECONDS=45

# Optional MTProto proxy
USE_PROXY=0
MTPROXY_SERVER=
MTPROXY_PORT=443
MTPROXY_SECRET=
