# Required
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Web -> isolated Telegram service. Use the same random token in its private env.
TELEGRAM_SERVICE_URL=http://127.0.0.1:5010
TELEGRAM_SERVICE_TOKEN=replace-with-a-separate-random-token
TELEGRAM_SERVICE_CONNECT_TIMEOUT=3
TELEGRAM_SERVICE_READ_TIMEOUT=30

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ArchiveDB data locations on OCI / Block Volume
TRANSLATED_CSV_PATH=/home/ubuntu/arcdb-data/uploaded_novels_tracker.csv
RAW_MASTER_CSV_PATH=/home/ubuntu/arcdb-data/master_library_index.csv
LOCAL_OUTPUT_DIR=/home/ubuntu/arcdb-data/output/
STRUCTURED_OUTPUT_DIR=/home/ubuntu/arcdb-data/structured_output/
BATCHED_EPUBS_DIR=/home/ubuntu/arcdb-data/batched_epubs/
META_DIR=/home/ubuntu/arcdb-data/metadata/
EPUB_PACKAGE_SESSIONS_DIR=/home/ubuntu/arcdb-data/tmp/epub_package_sessions
PACKAGE_JOBS_DB_PATH=/home/ubuntu/arcdb-data/metadata/package_jobs.sqlite3

# Upload/archive safety limits (bytes unless noted otherwise)
MAX_CONTENT_LENGTH=102760448
MAX_EPUB_UPLOAD_BYTES=94371840
MAX_COVER_UPLOAD_BYTES=8388608
MAX_EPUB_FILES=10000
MAX_EPUB_ENTRY_BYTES=134217728
MAX_EPUB_TEXT_ENTRY_BYTES=8388608
MAX_EPUB_UNCOMPRESSED_BYTES=786432000
MAX_EPUB_COMPRESSION_RATIO=250
MAX_EPUB_PACKAGE_IMAGE_BYTES=12582912
MAX_EPUB_PACKAGE_SESSION_BYTES=268435456
MAX_EPUB_PACKAGE_SESSION_FILES=1000
MAX_EPUB_PACKAGE_SESSIONS_PER_USER=3
EPUB_PACKAGE_SESSION_TTL_SECONDS=86400
PACKAGE_JOB_MAX_ATTEMPTS=3
PACKAGE_JOB_TIMEOUT_SECONDS=900
PACKAGE_JOB_STALE_SECONDS=60
PACKAGE_JOB_RETENTION_SECONDS=86400

# Site
ADMIN_EMAILS=
DMCA_EMAIL=
COOKIE_SECURE=1
HOST=127.0.0.1
PORT=5004

# Phase 3 read comparison. Keep legacy as the production default until parity is proven.
STATE_READ_BACKEND=legacy
STATE_READ_SHADOW_COMPARE=0
STATE_READ_SHADOW_STRICT=0
STATE_READ_SHADOW_REPORT_EVERY=1000
