# Required
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Telegram
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
SESSION_PATH=/home/ubuntu/arcdb-data/sigma_reverse_session

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional MTProto proxy
USE_PROXY=0
MTPROXY_SERVER=
MTPROXY_PORT=443
MTPROXY_SECRET=

# ArchiveDB data locations on OCI / Block Volume
TRANSLATED_CSV_PATH=/home/ubuntu/arcdb-data/uploaded_novels_tracker.csv
RAW_MASTER_CSV_PATH=/home/ubuntu/arcdb-data/master_library_index.csv
LOCAL_OUTPUT_DIR=/home/ubuntu/arcdb-data/output/
STRUCTURED_OUTPUT_DIR=/home/ubuntu/arcdb-data/structured_output/
BATCHED_EPUBS_DIR=/home/ubuntu/arcdb-data/batched_epubs/
META_DIR=/home/ubuntu/arcdb-data/metadata/

# Site
ADMIN_EMAILS=
DMCA_EMAIL=
COOKIE_SECURE=1
HOST=127.0.0.1
PORT=5004

# Local development without Telegram
ARCHIVEDB_NO_TELEGRAM=1

# Phase 3 read comparison. Keep legacy as the production default until parity is proven.
STATE_READ_BACKEND=legacy
STATE_READ_SHADOW_COMPARE=0
STATE_READ_SHADOW_STRICT=0
STATE_READ_SHADOW_REPORT_EVERY=1000
